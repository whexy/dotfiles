---
import { categories } from "../data/hosts";
---

<div class="space-y-12">
  {
    categories.map((cat) => (
      <div class="reveal">
        <div class="mb-4 flex items-baseline gap-3">
          <span class="text-nix text-sm">▸</span>
          <h3 class="text-snow text-sm font-bold tracking-wide uppercase">
            {cat.label}
          </h3>
          <span class="text-dim text-xs">
            {cat.hosts.length} {cat.hosts.length === 1 ? "target" : "targets"}
          </span>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {cat.hosts.map((host) => (
            <div class="group border-line bg-panel hover:border-nix/40 hover:bg-raised rounded-lg border p-4 transition-all duration-200 hover:-translate-y-0.5">
              <div class="text-snow group-hover:text-nix text-sm font-bold transition-colors">
                {host.label}
              </div>
              <div class="text-fog mt-1 text-xs leading-5">{host.hardware}</div>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {host.caps.map((cap) => (
                  <span class="border-line text-dim group-hover:border-nix/25 group-hover:text-nix/70 rounded-sm border px-1.5 py-0.5 text-[10px] transition-colors">
                    {cap}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
