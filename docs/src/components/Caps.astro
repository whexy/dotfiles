---
import { capNotes } from "../data/hosts";

const caps = Object.values(capNotes);
---

<div class="reveal">
  <div
    class="border-line bg-line grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2 lg:grid-cols-5"
  >
    {
      caps.map((cap) => (
        <div class="bg-panel hover:bg-raised p-5 transition-colors">
          <div class="text-nix text-sm font-bold">{cap.name}</div>
          <p class="text-fog mt-2 text-xs leading-5">{cap.blurb}</p>
        </div>
      ))
    }
  </div>
  <p class="text-dim mt-4 text-xs leading-5">
    // composed per host —
    <span class="text-fog">ord = base + dev + gui</span>,
    <span class="text-fog">mba = base + dev-lite + gui</span>,
    <span class="text-fog">remote-service = base + service</span>
  </p>
</div>
