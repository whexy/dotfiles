{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "autoupdate": false,
  "default_agent": "plan",
  "share": "disabled",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "/nix/store/**": "deny"
    }
  }
}
