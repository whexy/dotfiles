    bg2 = "#504945";
    fg = "#ebdbb2";
    fg4 = "#a89984";
    gray = "#928374";
    red = "#cc241d";
    redBright = "#fb4934";
    green = "#98971a";
    greenBright = "#b8bb26";
    yellow = "#d79921";
    blue = "#458588";
    blueBright = "#83a598";
    purple = "#b16286";
    purpleBright = "#d3869b";
    aqua = "#689d6a";
  };
