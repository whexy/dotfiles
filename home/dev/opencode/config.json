{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-6",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": false,
  "default_agent": "plan",
  "share": "disabled",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "/nix/store/**": "deny"
    }
  }
}
