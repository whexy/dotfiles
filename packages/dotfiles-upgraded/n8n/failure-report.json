    {
      "parameters": {
        "jsCode": "// Everything the host sent lands in code blocks or must match a strict\n// pattern, so a report cannot mention anyone or inject markdown.\nconst b = $input.first().json.body ?? {};\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\nconst sha = String(b.sha ?? '');\nif (!/^([0-9a-f]{40}|[0-9a-f]{64})$/.test(sha)) return reject('sha must be a full commit hash');\nconst configuration = String(b.configuration ?? '');\nif (!/^[A-Za-z0-9._@-]{1,64}$/.test(configuration)) return reject('configuration is missing or malformed');\nconst host = String(b.host ?? '');\nif (!/^[A-Za-z0-9._-]{0,253}$/.test(host)) return reject('host is malformed');\nconst mode = String(b.mode ?? '');\nif (!['nixos', 'darwin', 'home-manager'].includes(mode)) return reject('unknown mode');\n\nconst attempts = Number.isInteger(b.attempts) ? b.attempts : 0;\nconst error = String(b.error ?? '').slice(0, 2000);\nconst output = (Array.isArray(b.output) ? b.output : [])\n  .slice(-60)\n  .map((line) => String(line).replace(/\\x1b\\[[0-9;?]*[ -\\/]*[@-~]/g, '').slice(0, 1000));\n\nconst fence = (text) => {\n  const longest = Math.max(0, ...(text.match(/`+/g) ?? []).map((run) => run.length));\n  const f = '`'.repeat(Math.max(3, longest + 1));\n  return `${f}\\n${text}\\n${f}`;\n};\n\nconst who = host && host !== configuration\n  ? `\\`${configuration}\\` (${mode}, host \\`${host}\\`)`\n  : `\\`${configuration}\\` (${mode})`;\nconst plural = attempts === 1 ? '' : 's';\nconst details = [\n  `Last error, after ${attempts} attempt${plural}:`,\n  fence(error),\n  output.length\n    ? `<details><summary>Last ${output.length} lines of rebuild output</summary>\\n\\n${fence(output.join('\\n'))}\\n\\n</details>`\n    : '',\n].filter(Boolean).join('\\n\\n');\n\nconst marker = `<!-- dotfiles-upgraded sha=${sha} -->`;\nreturn [{\n  json: {\n    valid: true,\n    sha,\n    marker,\n    title: `Auto-upgrade cannot switch to ${sha.slice(0, 7)}`,\n    issueBody: [\n      marker,\n      `${who} gave up switching to ${sha}.`,\n      details,\n      'Every other host that gives up on this commit adds a comment here.',\n    ].join('\\n\\n'),\n    commentBody: [`+1 ${who} also gave up on this commit.`, details].join('\\n\\n'),\n  },\n}];\n"
      },
