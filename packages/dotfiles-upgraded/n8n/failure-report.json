    {
      "parameters": {
        "jsCode": "// The marker in the body, not a label, identifies the issue: GitHub drops\n// labels it will not let the app set, and the marker cannot be edited away\n// by retitling the issue. GitHub's issue list shows a new issue only seconds\n// after it is opened, so issues this workflow opened in the last hour are\n// also remembered here.\nconst recent = ($getWorkflowStaticData('global').recent ??= {});\nconst now = Date.now();\nfor (const [sha, entry] of Object.entries(recent)) {\n  if (now - entry.at > 3600 * 1000) delete recent[sha];\n}\n\nconst report = $('Validate').first().json;\nconst issues = $input.first().json.body ?? [];\nconst listed = issues.find((i) => !i.pull_request && (i.body ?? '').includes(report.marker));\nreturn [{ json: { ...report, existing: listed?.number ?? recent[report.sha]?.number ?? null } }];\n"
      },
